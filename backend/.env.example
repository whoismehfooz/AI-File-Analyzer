APP_NAME="AI Document Analyzer"
APP_ENV=development
DEBUG=false

MAX_UPLOAD_SIZE_MB=15
MAX_EXTRACTED_CHARACTERS=6000000

MAX_PDF_PAGES=250

MAX_DOCX_UNCOMPRESSED_MB=100
MAX_DOCX_COMPRESSION_RATIO=100
MAX_DOCX_ARCHIVE_FILES=10000

MAX_CSV_ROWS=50000
MAX_CSV_COLUMNS=200

MAX_EXCEL_SHEETS=20
MAX_EXCEL_ROWS_PER_SHEET=50000
MAX_EXCEL_COLUMNS_PER_SHEET=200
MAX_EXCEL_TOTAL_CELLS=1000000

ALLOWED_DOCUMENT_EXTENSIONS=.txt,.pdf,.docx,.csv,.xls,.xlsx
